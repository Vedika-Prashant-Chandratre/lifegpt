# LifeGPT Application Configuration
# Copy this file to .env and fill in your values for local development.
# For Vercel deployment, set these as Environment Variables in the Vercel dashboard.

APP_ENV=production
APP_URL=https://your-project.vercel.app
APP_SECRET=replace_with_a_secure_random_32_char_string

# Database Configuration (use a cloud MySQL provider: Aiven, PlanetScale, Clever Cloud)
DB_HOST=your-cloud-db-host
DB_PORT=3306
DB_NAME=lifegpt
DB_USER=your-db-user
DB_PASS=your-db-password

# AI API Key (Groq - free tier, fast inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Mailer Configuration (optional - leave blank to disable email features)
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME=LifeGPT
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

