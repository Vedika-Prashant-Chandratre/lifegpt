# LifeGPT Application Configuration
APP_ENV=local
APP_URL=http://localhost/lifegpt
APP_SECRET=replace_this_with_a_secure_random_string_32_chars

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lifegpt
DB_USER=root
DB_PASS=

# OpenAI API Configuration
# Replace with your actual key in your local .env file
OPENAI_API_KEY=your_openai_api_key_here

# Mailer Configuration (optional, can fallback to mailtodisk or simulated mailing)
MAIL_FROM_ADDRESS=noreply@lifegpt.local
MAIL_FROM_NAME="LifeGPT"
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
