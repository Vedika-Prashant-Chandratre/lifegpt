{
  "functions": {
    "api/**/*.php": { "runtime": "vercel-php@0.7.3" },
    "account/**/*.php": { "runtime": "vercel-php@0.7.3" },
    "interview/**/*.php": { "runtime": "vercel-php@0.7.3" },
    "*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
